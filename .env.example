# Availity Clearinghouse Configuration
# Copy this file to .env and fill in your actual values

# Your Availity-assigned Submitter ID (up to 15 chars, assigned when you enroll)
AVAILITY_SENDER_ID=YOUR_SUBMITTER_ID

# Availity sender qualifier — ZZ for mutually defined (most practices use ZZ)
AVAILITY_SENDER_QUAL=ZZ

# Usage: T = Test/Sandbox, P = Production
# Start with T until Availity approves your test submissions
AVAILITY_USAGE=T

# GS02 Application Sender ID (often your Tax ID or same as Sender ID)
AVAILITY_GS_SENDER_ID=YOUR_SUBMITTER_ID

# ── Stedi Eligibility API ─────────────────────────────────────────────────────
# Obtain from: https://www.stedi.com → API Keys
STEDI_API_KEY=your_stedi_api_key_here

# React: Anthropic API key (for report generation)
REACT_APP_ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Express server port
PORT=3001
