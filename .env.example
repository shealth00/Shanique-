# ── Availity Clearinghouse ────────────────────────────────────────────────────
# Your Availity-assigned Submitter ID (up to 15 chars)
AVAILITY_SENDER_ID=YOUR_AVAILITY_SUBMITTER_ID

# Sender qualifier — ZZ for most practices
AVAILITY_SENDER_QUAL=ZZ

# Usage indicator: P = Production, T = Test/Sandbox
# Leave as P for live claims and eligibility checks
AVAILITY_USAGE=P

# GS02 Application Sender ID (often same as Sender ID or your Tax ID)
AVAILITY_GS_SENDER_ID=YOUR_AVAILITY_SUBMITTER_ID

# ── Stedi Eligibility API ─────────────────────────────────────────────────────
# Obtain from: https://app.stedi.com/app/settings/api-keys
STEDI_API_KEY=YOUR_STEDI_API_KEY

# ── Anthropic API (report generation) ────────────────────────────────────────
REACT_APP_ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production
